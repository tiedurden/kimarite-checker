# Put the required binaries on PATH:  cp env.sh.example env.sh && source env.sh
#
# On Windows, WinGet installs ffmpeg / yt-dlp / tesseract but does NOT create
# shims in its Links dir, so none of them land on PATH. Rather than edit the
# system PATH, source this. On Linux/macOS the package managers do this for you
# and you can skip the PATH block entirely.

_wg="$LOCALAPPDATA/Microsoft/WinGet/Packages"
_ff="$_wg/Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe/ffmpeg-8.1.2-full_build/bin"
_yt="$_wg/yt-dlp.yt-dlp_Microsoft.Winget.Source_8wekyb3d8bbwe"

# Version-pinned path above will break on ffmpeg upgrade; fall back to a glob.
if [ ! -x "$_ff/ffmpeg.exe" ]; then
  _ff=$(dirname "$(find "$_wg" -iname ffmpeg.exe 2>/dev/null | head -1)")
fi

_ts="$LOCALAPPDATA/Programs/Tesseract-OCR"          # OCR for Herbert captions
[ -x "$_ts/tesseract.exe" ] || _ts="/c/Program Files/Tesseract-OCR"

# The venv goes FIRST so `python` means the venv's interpreter. Without this,
# `python` can resolve to a system Python while pip_install() installs into
# .venv -- two divergent environments. Scripts that use only stdlib run fine and
# hide the split, then extract_features.py dies on `import torch` with the wheel
# sitting installed 20 cm away.
_vp="$PWD/.venv/Scripts"                 # Linux/macOS: $PWD/.venv/bin
[ -x "$_vp/python.exe" ] || [ -x "$_vp/python" ] || _vp=""

export PATH="${_vp:+$_vp:}$_ff:$_yt:$_ts:$PATH"

# --- Corporate network only -------------------------------------------------
# Skip this whole section on a home network; it exists because an intercepting
# proxy needs OPPOSITE treatment per tool, which cost real debugging time:
#
#   pip     needs the proxy UNSET. If NO_PROXY contains your internal domain and
#           the proxy's own hostname is inside that domain, pip tries to resolve
#           the proxy without using it -> NameResolutionError.
#   yt-dlp  needs the proxy SET. Without it YouTube TLS fails with
#           CERTIFICATE_VERIFY_FAILED, because the proxy does TLS interception
#           and its CA is what the system trusts -- not the real chain.
#
# So: leave the proxy vars alone (yt-dlp is the common case) and strip them only
# for pip, via this helper. Set PROXY_HOST in your own env.sh if you need one.
pip_install() {
  env -u HTTP_PROXY -u HTTPS_PROXY -u http_proxy -u https_proxy \
    "$PWD/.venv/Scripts/python.exe" -m pip install "$@"
}
# ---------------------------------------------------------------------------

for _t in ffmpeg ffprobe yt-dlp tesseract; do
  command -v "$_t" >/dev/null 2>&1 || echo "WARNING: $_t still not found" >&2
done
# Guard against the interpreter split silently coming back (e.g. sourced from
# another directory, so $PWD/.venv doesn't exist and the glob above blanks out).
case "$(command -v python)" in
  *.venv*) ;;
  *) echo "WARNING: python is $(command -v python), NOT the venv --" \
          "pip_install targets .venv, so imports will not match" >&2 ;;
esac
unset _wg _ff _yt _ts _vp _t
